/* Hallmark · v2.0.0 · scope: app · redesign: restyle · theme: project tokens · signature: team roster · system font · no motion */
/* critique: cramped member metadata fixed with full-width roster rows; preserve shell and all handlers */
.topline { display: flex; justify-content: flex-end; align-items: center; margin-bottom: 24rpx; gap: 16rpx; }
.role { border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; background: var(--surface); white-space: nowrap; }
.hero { background: var(--surface); border-radius: 24rpx 24rpx 0 0; padding: 32rpx; margin-top: 20rpx; }
.hero-title { font-size: 40rpx; font-weight: 650; line-height: 1.4; word-break: break-all; }
.stats { display: flex; padding: 24rpx 0 32rpx; background: var(--surface); border-radius: 0 0 24rpx 24rpx; margin-bottom: 24rpx; }
.stats > view { flex: 1; text-align: center; font-size: 28rpx; color: var(--muted); }
.stat-number { display: block; font-size: 48rpx; color: var(--text); font-weight: 500; margin-bottom: 6rpx; font-variant-numeric: tabular-nums; }
.project-card { background: var(--surface); border-radius: 24rpx; padding: 28rpx; margin-bottom: 16rpx; }
.project-card:active { background: #e9edef; }
.project-info { display: flex; flex-direction: column; gap: 20rpx; }
.project-info .bold { font-size: 32rpx; min-width: 0; }
.project-info .small { font-size: 28rpx; }
.project-info > .between:last-child { flex-wrap: wrap; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; display: flex; padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); z-index: 10; }
.nav-item { flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; color: var(--muted); font-size: 28rpx; position: relative; min-height: 100rpx; }
.nav-icon { display: none; }
.active { color: var(--text); font-weight: 650; }
.nav-dot { height: 4rpx; width: 32rpx; border-radius: 4rpx; background: var(--accent); position: absolute; bottom: 8rpx; }
.members { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }
.member { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; padding: 16rpx 0; min-height: 88rpx; }
.member-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; font-size: 28rpx; }
.ranking { display: flex; align-items: center; gap: 20rpx; }
.rank-number { font-size: 36rpx; color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
.rank-info { flex: 1; min-width: 0; }
.score { font-size: 44rpx; color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.score text { font-size: 28rpx; margin-left: 8rpx; color: var(--muted); }
.profile { text-align: center; padding: 40rpx; }
.avatar-button { padding: 0; background: none; width: 140rpx; margin: 0 auto 24rpx; }
.profile-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; font-size: 56rpx; }
.section .small { min-height: 88rpx; display: flex; align-items: center; }
.project-toolbar { display: flex; justify-content: flex-end; margin: 8rpx 0 24rpx; }
.rank-progress { margin-top: 18rpx; width: 100%; }

.home-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.home-page > .topline, .home-page .hero, .home-page .stats { flex-shrink: 0; }
.project-list { flex: 1; height: 0; min-height: 0; width: 100%; }
.profile-name-field { text-align: left; }
.profile-save { width: 100%; margin-top: 24rpx; }
.profile-notice { margin-bottom: 16rpx; flex-shrink: 0; }
.team-editor { border: 1rpx solid var(--border); }
.compact { min-height: 88rpx; padding: 16rpx 24rpx; flex-shrink: 0; }
.member-result { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.member-result > .row { min-width: 0; }
.member-result .small { word-break: break-all; }
button.compact { width: auto; }
button.profile-save { width: 100%; }
.stats > view { min-height: 100rpx; }
.stats > view:active { opacity: .65; }
.stats-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, .35); }
.stats-panel { width: 100%; max-width: 1100rpx; max-height: 82vh; display: flex; flex-direction: column; padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: var(--surface); }
.stats-panel-header { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; flex-shrink: 0; }
.stats-panel-title { flex: 1; min-width: 0; font-size: 36rpx; font-weight: 600; }
button.stats-panel-close { width: auto; min-height: 88rpx; margin: 0 0 0 auto; padding: 16rpx 24rpx; flex-shrink: 0; }
.stats-panel-list { min-height: 120rpx; max-height: 54vh; flex-shrink: 1; }
.stats-project { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; min-height: 112rpx; border-bottom: 1rpx solid var(--border); }
.stats-project:active { background: var(--raised); }
.stats-project-info { flex: 1; min-width: 0; word-break: break-all; }
.stats-project-score { flex-shrink: 0; font-variant-numeric: tabular-nums; text-align: right; }
.stats-project-arrow { flex-shrink: 0; font-size: 36rpx; color: var(--muted); }
.stats-panel-footer { display: flex; justify-content: space-between; gap: 20rpx; flex-shrink: 0; padding-top: 24rpx; font-size: 28rpx; font-variant-numeric: tabular-nums; }

.teams-screen { --team-accent-soft: #fceee5; --team-focus: #b94e16; }
.teams-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin: 8rpx 0 32rpx; }
.teams-heading-row > view { min-width: 0; flex: 1; }
.teams-heading-row .heading { margin: 0 0 12rpx; }
.teams-screen button { font-size: 28rpx; min-height: 88rpx; padding: 20rpx 24rpx; margin: 0; flex-shrink: 0; }
button.teams-create { background: var(--text); color: var(--surface); width: auto; }
.team-roster { background: var(--surface); border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; border: 2rpx solid var(--surface); }
.team-roster-mine { border-color: var(--accent); }
.team-roster-header { display: flex; align-items: center; gap: 20rpx; padding-bottom: 24rpx; }
.team-roster-avatar { width: 96rpx; height: 96rpx; border-radius: 20rpx; flex-shrink: 0; }
.team-initial { background: var(--raised); color: var(--muted); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 34rpx; }
.team-roster-title { flex: 1; min-width: 0; }
.team-name { font-size: 36rpx; font-weight: 600; line-height: 1.35; overflow-wrap: break-word; min-width: 0; }
.team-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; font-size: 26rpx; color: var(--muted); margin-top: 10rpx; }
.team-mine-label { color: var(--accent); }
button.team-edit { width: auto; color: var(--text); background: var(--raised); }
.team-people { border-top: 1rpx solid var(--border); }
.team-person { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; padding: 20rpx 0; }
.team-person + .team-person { border-top: 1rpx solid var(--border); }
.team-person-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; font-size: 28rpx; }
.team-person-name { flex: 1; min-width: 0; overflow-wrap: break-word; }
.team-captain { font-size: 26rpx; color: var(--accent); background: var(--team-accent-soft); padding: 6rpx 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.team-no-members { padding: 28rpx 0; }
.team-roster-actions { display: flex; justify-content: flex-end; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
button.team-leave { background: var(--raised); color: var(--muted); width: auto; }
button.team-join { width: 100%; }
.team-allocation { margin-top: 40rpx; }
.team-allocation .section { margin: 0 0 12rpx; }
.team-allocation-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 100rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); overflow-wrap: break-word; }
.team-allocation-row > text:first-child { flex: 1; min-width: 0; }
.team-allocation-action { font-size: 28rpx; color: var(--accent); flex-shrink: 0; }
.teams-screen button:focus-visible, .team-person:focus-visible, .team-allocation-row:focus-visible { outline: 4rpx solid var(--team-focus); outline-offset: 4rpx; }
.teams-screen button:active, .team-allocation-row:active { opacity: .7; }

.project-toolbar { display: block; }
.project-toolbar button { width: 100%; margin: 0; }
