<view class="page {{tab === 'home' ? 'home-page' : ''}}">
  <view class="topline"><text class="role">{{state.role}}</text><text class="orange" bindtap="manualRefresh">刷新</text></view>
  <view wx:if="{{cloudError}}" class="card" bindtap="manualRefresh">{{cloudError}} · 点击重试</view>
  <block wx:if="{{tab === 'home'}}">
    <view wx:if="{{state.revision >= 0 && (!me.name || me.name === '微信用户')}}" class="notice profile-notice" bindtap="openProfile">完善个人资料：使用微信头像并填写姓名 →</view>
    <view class="hero"><view class="hero-title" bindtap="editActivity" role="{{state.role === '管理员' ? 'button' : 'heading'}}" aria-label="{{state.role === '管理员' ? '点击修改活动名称' : state.activity}}">{{state.activity}}</view></view>
    <view class="stats">
      <view data-type="pending" bindtap="openStatsPanel" role="button" aria-label="查看待参与项目"><text class="stat-number">{{pending}}</text><text>待参与</text></view>
      <view data-type="completed" bindtap="openStatsPanel" role="button" aria-label="查看已完成项目"><text class="stat-number">{{completed}}</text><text>已完成</text></view>
      <view data-type="score" bindtap="openStatsPanel" role="button" aria-label="查看各项目得分"><text class="stat-number">{{totalScore}}</text><text>总得分</text></view>
    </view>
    <scroll-view id="project-list" class="project-list" scroll-y="true" enhanced="true" show-scrollbar="true" scroll-into-view="{{projectScrollTarget}}" scroll-with-animation="false">
      <view id="project-list-content">
    <view wx:for="{{projects}}" wx:key="id" id="project-{{index}}" class="project-card" data-id="{{item.id}}" bindtap="openProject"><view class="project-info"><view class="between"><text class="bold">{{item.name}}</text><text wx:if="{{item.hasTeam}}" class="status status-{{item.participationStatus}}">{{entryStatuses[item.participationStatus]}}</text></view><view wx:if="{{item.address}}" class="small muted ellipsis">⌖ {{item.address}}</view><view class="between small"><text>{{item.start}} — {{item.end}}</text></view></view></view>

        <view wx:if="{{!projects.length}}" class="empty">暂无项目</view>
        <view wx:if="{{state.role === '管理员'}}" class="project-toolbar"><button class="secondary" bindtap="addProject">＋ 新项目</button></view>
        <view style="height: {{scrollSpacerHeight}}px" aria-hidden="true"/>
      </view>
    </scroll-view>
  </block>
  <view wx:if="{{tab === 'teams'}}" class="teams-screen">
    <view class="teams-heading-row"><view><view class="heading">我的队伍</view><view class="small muted">共 {{teams.length}} 支队伍</view></view><button wx:if="{{state.role === '管理员'}}" class="teams-create" bindtap="createTeam">创建队伍</button></view>
    <view wx:for="{{teams}}" wx:key="id" class="team-roster {{item.mine ? 'team-roster-mine' : ''}}" data-id="{{item.id}}" bindtap="openTeam" role="button" aria-label="查看{{item.name}}队伍详情">
      <view class="team-roster-header">
        <image wx:if="{{item.avatar}}" class="team-roster-avatar" data-id="{{item.id}}" catchtap="chooseTeamAvatar" src="{{item.avatar}}" mode="aspectFill"/>
        <view wx:else class="team-roster-avatar team-initial" data-id="{{item.id}}" catchtap="chooseTeamAvatar">{{item.name[0]}}</view>
        <view class="team-roster-title"><view class="team-name" data-id="{{item.id}}" catchtap="renameTeam">{{item.name}}</view><view class="team-meta"><text>{{item.members.length}} 位伙伴</text><text wx:if="{{item.mine}}" class="team-mine-label">我的队伍</text></view></view>

      </view>
      <view class="team-people">
        <view wx:for="{{item.members}}" wx:for-item="member" wx:key="id" class="team-person">
          <image wx:if="{{member.avatar}}" src="{{member.avatar}}" class="team-person-avatar" mode="aspectFill"/>
          <view wx:else class="team-person-avatar team-initial">{{member.name ? member.name[0] : '人'}}</view>
          <text class="team-person-name">{{member.name || '未填写姓名'}}</text><text wx:if="{{member.id === item.captainId}}" class="team-captain">队长</text>
        </view>
        <view wx:if="{{!item.members.length}}" class="team-no-members small muted">暂无成员</view>
      </view>
      <view wx:if="{{item.mine || !me.teamId}}" class="team-roster-actions"><button wx:if="{{item.mine}}" class="team-leave" catchtap="leaveTeam">退出队伍</button><button wx:if="{{!me.teamId}}" class="teams-create team-join" data-id="{{item.id}}" catchtap="joinTeam">加入这支队伍</button></view>
    </view>
    <view wx:if="{{!teams.length}}" class="empty">暂无队伍</view>
  </view>
  <block wx:if="{{tab === 'rank'}}"><view class="heading">队伍排行榜</view><view class="card ranking" wx:for="{{ranking}}" wx:key="id"><text class="rank-number">{{item.rank}}</text><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}"/><view class="rank-info"><view class="bold">{{item.name}}</view><progress class="rank-progress" percent="{{item.progress}}" stroke-width="6" activeColor="#b94e16" backgroundColor="#e9edef" border-radius="6" aria-label="评分进度 {{item.progress}}%"/></view><view class="score">{{item.score}}<text>分</text></view></view><view wx:if="{{!ranking.length}}" class="empty">创建第一支队伍，开启挑战。</view></block>
  <block wx:if="{{tab === 'me'}}">
    <view class="heading">个人资料</view>
    <view class="card profile">
      <button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" class="avatar-button" aria-label="授权使用微信头像">
        <image wx:if="{{me.avatar}}" src="{{me.avatar}}" class="profile-avatar"/>
        <view wx:else class="profile-avatar fallback">{{me.name ? me.name[0] : '人'}}</view>
      </button>
      <button class="secondary" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">{{me.avatar ? '更新微信头像' : '授权使用微信头像'}}</button>
      <view class="profile-name-field"><text class="field-label">姓名</text><input type="text" value="{{nameDraft}}" bindinput="inputName" maxlength="30" aria-label="姓名"/></view>
      <button class="primary profile-save" bindtap="saveName">保存姓名</button>
    </view>
    <view class="card"><view class="between"><text>当前身份</text><text>{{state.role}}</text></view><view class="small muted">由活动管理员授权</view><button class="secondary" bindtap="copyIdentity">复制我的 OpenID（用于授权）</button></view>
  </block>

  
</view>
<view class="bottom-nav"><view wx:for="{{tabs}}" wx:key="id" class="nav-item {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tabChange"><text class="nav-icon">{{item.icon}}</text><text>{{item.name}}</text><view wx:if="{{tab === item.id}}" class="nav-dot"/></view></view>

<view wx:if="{{statsPanelType}}" class="stats-mask" bindtap="closeStatsPanel">
  <view class="stats-panel" catchtap="stopPanelTap" role="dialog" aria-label="{{statsPanelTitle}}">
    <view class="stats-panel-header"><view class="stats-panel-title">{{statsPanelTitle}}</view><button class="stats-panel-close secondary" bindtap="closeStatsPanel" aria-label="关闭项目列表">关闭</button></view>
    <scroll-view class="stats-panel-list" style="height: {{statsProjects.length ? statsProjects.length * 161 : 200}}rpx" scroll-y="true">
      <view wx:for="{{statsProjects}}" wx:key="id" class="stats-project" data-id="{{item.id}}" bindtap="openStatsProject" role="button" aria-label="查看{{item.name}}详情">
        <view class="stats-project-info"><view class="bold">{{item.name}}</view><view class="small muted">{{entryStatuses[item.status]}}</view></view>
        <view wx:if="{{statsPanelType === 'score'}}" class="stats-project-score">{{item.score === null ? '待评分' : item.score + ' 分'}}</view>
        <text class="stats-project-arrow" aria-hidden="true">›</text>
      </view>
      <view wx:if="{{!statsProjects.length}}" class="empty">{{!statsPanelTeam ? '加入队伍后可查看本队项目和得分' : statsPanelType === 'pending' ? '暂无待参与项目' : statsPanelType === 'completed' ? '暂无已完成项目' : '暂无项目得分'}}</view>
    </scroll-view>
    <view class="stats-panel-footer"><text>共 {{statsProjects.length}} 个项目</text><text wx:if="{{statsPanelType === 'score'}}">总得分 {{totalScore}} 分</text></view>
  </view>
</view>
