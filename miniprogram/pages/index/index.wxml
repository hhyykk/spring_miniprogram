<view class="page {{tab === 'home' ? 'home-page' : ''}}">
  <view class="topline"><text class="role">{{state.role}}</text><text class="orange" bindtap="manualRefresh">刷新</text></view>
  <view wx:if="{{cloudError}}" class="card" bindtap="manualRefresh">{{cloudError}} · 点击重试</view>
  <block wx:if="{{tab === 'home'}}">
    <view class="hero"><view class="activity-title-row"><view class="hero-title">{{state.activity}}</view><button wx:if="{{state.role === '管理员'}}" class="activity-edit secondary" bindtap="editActivity">编辑</button></view></view>
    <view class="stats"><view><text class="stat-number">{{pending}}</text><text>待开始</text></view><view><text class="stat-number">{{completed}}</text><text>已完成</text></view><view><text class="stat-number">{{totalScore}}</text><text>总得分</text></view></view>
    <view wx:if="{{state.role === '管理员'}}" class="project-toolbar"><button class="secondary" bindtap="addProject">＋ 新项目</button></view>
    <scroll-view id="project-list" class="project-list" scroll-y="true" enhanced="true" show-scrollbar="true" scroll-into-view="{{projectScrollTarget}}" scroll-with-animation="false">
      <view id="project-list-content">
    <view wx:for="{{projects}}" wx:key="id" id="project-{{index}}" class="project-card" data-id="{{item.id}}" bindtap="openProject"><view class="project-info"><view class="between"><text class="bold">{{item.name}}</text><text class="status status-{{item.status}}">{{statuses[item.status]}}</text></view><view class="small muted ellipsis">⌖ {{item.address}}</view><view class="between small"><text>{{item.start}} — {{item.end}}</text></view></view></view>

        <view wx:if="{{!projects.length}}" class="empty">暂无项目</view>
        <view style="height: {{scrollSpacerHeight}}px" aria-hidden="true"/>
      </view>
    </scroll-view>
  </block>
  <block wx:if="{{tab === 'teams'}}"><view class="heading">我的队伍</view><view class="between section"><text>我们的队伍</text><text wx:if="{{state.role === '管理员'}}" class="orange small" bindtap="createTeam">＋ 创建队伍</text></view><view wx:for="{{teams}}" wx:key="id" class="card"><view class="between"><view class="row"><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="avatar fallback">⚑</view><view><view class="bold">{{item.name}} <text wx:if="{{item.mine}}" class="tag">我的</text></view><view class="small muted">{{item.members.length}} 位伙伴</view></view></view><text wx:if="{{state.role === '管理员' || item.captainId === me.id}}" class="orange" data-id="{{item.id}}" bindtap="editTeam">编辑</text></view><view class="members"><view wx:for="{{item.members}}" wx:for-item="member" wx:key="id" class="member" data-id="{{member.id}}" bindtap="moveMember"><image wx:if="{{member.avatar}}" src="{{member.avatar}}" class="member-avatar"/><view wx:else class="member-avatar fallback">{{member.name[0]}}</view><text>{{member.name}}</text><text wx:if="{{member.id === item.captainId}}" class="orange"> · 队长</text></view></view><button wx:if="{{item.mine}}" class="secondary" bindtap="leaveTeam">退出队伍</button><button wx:if="{{!me.teamId}}" class="primary" data-id="{{item.id}}" bindtap="joinTeam">加入这支队伍</button></view><view class="card" wx:if="{{state.role === '管理员'}}"><view class="bold">成员调配</view><view class="member" wx:for="{{state.members}}" wx:key="id" data-id="{{item.id}}" bindtap="moveMember">{{item.name}} <text class="orange">调整队伍 →</text></view></view></block>
  <block wx:if="{{tab === 'rank'}}"><view class="heading">队伍排行榜</view><view class="card ranking" wx:for="{{ranking}}" wx:key="id"><text class="rank-number">{{item.rank}}</text><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}"/><view class="rank-info"><view class="bold">{{item.name}}</view><progress class="rank-progress" percent="{{item.progress}}" stroke-width="6" activeColor="#b94e16" backgroundColor="#e9edef" border-radius="6" aria-label="评分进度 {{item.progress}}%"/></view><view class="score">{{item.score}}<text>分</text></view></view><view wx:if="{{!ranking.length}}" class="empty">创建第一支队伍，开启挑战。</view></block>
  <block wx:if="{{tab === 'me'}}"><view class="heading">你好，<text class="orange">{{me.name}}。</text></view><view class="card profile"><button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" class="avatar-button"><image wx:if="{{me.avatar}}" src="{{me.avatar}}" class="profile-avatar"/><view wx:else class="profile-avatar fallback">{{me.name[0]}}</view></button><view class="bold" bindtap="changeName">{{me.name}} ✎</view></view><view class="card"><view class="between"><text>当前身份</text><text>{{state.role}}</text></view><view class="small muted">由活动管理员授权</view><button class="secondary" bindtap="copyIdentity">复制我的 OpenID（用于授权）</button></view></block>
  
</view>
<view class="bottom-nav"><view wx:for="{{tabs}}" wx:key="id" class="nav-item {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tabChange"><text class="nav-icon">{{item.icon}}</text><text>{{item.name}}</text><view wx:if="{{tab === item.id}}" class="nav-dot"/></view></view>
