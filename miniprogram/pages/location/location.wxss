.map-heading { padding: 32rpx; }
.map-heading .heading { margin: 0; }
.map-wrap { position: relative; height: 58vh; min-height: 500rpx; margin: 0 16rpx; border-radius: 24rpx; overflow: hidden; }
map { width: 100%; height: 100%; }
.center-pin { position: absolute; top: 50%; left: 50%; margin-left: -28rpx; margin-top: -28rpx; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 48rpx; color: #b94e16; }
.map-bottom { padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
