<view class="map-page"><view class="map-heading"><view class="heading">{{edit ? '设置精确地点' : id ? '项目在哪里' : '队友示意地图'}}</view></view><view class="map-wrap"><map id="venue-map" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}" scale="17" bindtap="onMapTap" bindregionchange="onRegionChange" enable-scroll="true" enable-zoom="true"/><cover-view wx:if="{{edit}}" class="center-pin">⌖</cover-view></view><view class="map-bottom"><block wx:if="{{edit}}"><button class="secondary" bindtap="searchPlace">搜索地点</button><text class="field-label">说明</text><input value="{{address}}" bindinput="inputAddress"/><button class="primary" style="margin-top:20rpx" bindtap="saveLocation">保存</button></block><view wx:elif="{{id}}" class="card">⌖ {{address}}</view><block wx:else><view class="card" wx:for="{{teammates}}" wx:key="id">{{item.name}} <text class="small muted">· 模拟位置</text></view><view wx:if="{{!teammates.length}}" class="empty">加入队伍后即可查看队友示意位置</view></block></view></view>
