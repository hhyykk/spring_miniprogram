<view class="page"><view class="heading">3D 场地示意</view><view class="scene-wrap"><canvas type="webgl" id="venue" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd"/><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="between"><text>场地视角</text><view class="row"><button class="secondary" data-direction="out" bindtap="zoom">−</button><button class="secondary" data-direction="in" bindtap="zoom">＋</button></view></view><view class="legend"><text>◼ 草坪</text><text>◼ 球场</text><text>◼ 湖畔</text><text>◼ 广场</text></view><view class="card" wx:if="{{selected}}"><picker range="{{projects}}" range-key="name" bindchange="chooseProject"><view class="between"><text class="bold">{{selected.name}}</text><text class="orange">切换 ⌄</text></view></picker><view class="small muted" style="margin-top:18rpx">◇ {{spots[selected.spot]}} · 3D 示意位置</view><view class="small muted">⌖ {{selected.address}}</view><picker wx:if="{{admin}}" range="{{spots}}" value="{{selected.spot}}" bindchange="setSpot"><view class="pill" style="margin-top:22rpx">设置项目位置：{{spots[selected.spot]}} ⌄</view></picker><button class="primary" style="margin-top:24rpx" bindtap="detail">查看项目详情 ↗</button></view><view wx:else class="empty">暂无项目，请管理员先添加项目。</view></view>
