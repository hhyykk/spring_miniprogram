<view class="scene-fullscreen">
  <canvas type="webgl" id="venue" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
  <cover-view role="button" class="scene-back" style="top: {{backTop}}px; height: {{backHeight}}px" bindtap="back" aria-label="返回项目详情">‹</cover-view>
  <cover-view class="scene-controls" style="bottom: {{controlsBottom}}px">
    <cover-view role="button" class="scene-control" data-direction="out" bindtap="zoom" aria-label="缩小模型">−</cover-view>
    <cover-view role="button" class="scene-control" data-direction="in" bindtap="zoom" aria-label="放大模型">＋</cover-view>
  </cover-view>
  <cover-view wx:if="{{error}}" class="scene-error">{{error}}</cover-view>
  </canvas>
</view>
