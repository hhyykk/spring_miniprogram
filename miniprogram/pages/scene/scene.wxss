page { height: 100%; overflow: hidden; background: #f0eee7; }
.scene-fullscreen { position: fixed; inset: 0; width: 100%; height: 100%; overflow: hidden; background: #f0eee7; }
#venue { display: block; width: 100%; height: 100%; }
.scene-back { position: absolute; z-index: 10; left: 24rpx; width: 88rpx; min-height: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #ffffff; color: #202428; font-size: 56rpx; font-weight: 400; line-height: 1; }
.scene-controls { position: absolute; z-index: 10; right: 28rpx; bottom: 28rpx; display: flex; gap: 16rpx; }
.scene-control { width: 96rpx; height: 96rpx; min-height: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: #ffffff; color: #202428; font-size: 40rpx; }
.scene-error { position: absolute; z-index: 10; left: 32rpx; right: 32rpx; top: 40%; padding: 28rpx; background: #ffffff; border-radius: 16rpx; text-align: center; color: #202428; line-height: 1.6; font-size: 28rpx; }
