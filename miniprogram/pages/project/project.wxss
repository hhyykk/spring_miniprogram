.project-rules { white-space: pre-wrap; line-height: 1.7; }
.project-map { width: 100%; height: 380rpx; border-radius: 16rpx; overflow: hidden; }
.map-address { margin-top: 22rpx; font-size: 30rpx; }
.location-error { margin-top: 16rpx; font-size: 28rpx; line-height: 1.6; color: var(--muted); word-break: break-all; }
.edit-location { margin-top: 16rpx; }
.model-preview { position: relative; width: 100%; height: 400rpx; border-radius: 16rpx; overflow: hidden; background: #f0eee7; }
.model-preview:active { opacity: .8; }
.model-image { width: 100%; height: 100%; }
.model-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; padding: 32rpx; font-size: 28rpx; color: var(--muted); }
.model-open { position: absolute; bottom: 16rpx; right: 16rpx; background: var(--surface); color: var(--text); border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.preview-canvas { position: fixed; left: -2000px; top: 0; width: 622rpx; height: 400rpx; pointer-events: none; }
.detail-tabs { display: flex; gap: 28rpx; border-bottom: 1rpx solid var(--border); margin-bottom: 28rpx; }
.detail-tab { flex: 1; min-height: 96rpx; padding: 22rpx 8rpx; border-radius: 0; background: transparent; color: var(--muted); border-bottom: 4rpx solid transparent; }
.detail-tab.selected { color: var(--text); border-bottom-color: var(--text); }
.project-title { display: flex; align-items: flex-start; gap: 20rpx; }
.project-title .heading { flex: 1; min-width: 0; }
.description-input { min-height: 240rpx; width: 100%; line-height: 1.7; }
.description-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
button.description-save, button.description-reload, button.description-cancel { width: auto; }
.description-error { color: #ad3232; font-size: 28rpx; line-height: 1.6; margin-top: 16rpx; }
.editable-title, .editable-description { cursor: pointer; }
.editable-description { min-height: 88rpx; padding: 12rpx 0; }
button.project-delete { display: block; width: 100%; margin-top: 36rpx; }
