page {
  --ground: #f3f4f5;
  --surface: #ffffff;
  --raised: #f4f5f6;
  --text: #202428;
  --muted: #60676d;
  --accent: #b94e16;
  --border: #e9ecee;
  background: var(--ground);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}
view, text, button, input, textarea { box-sizing: border-box; }
button {
  font-size: 28rpx;
  line-height: 1.5;
  border-radius: 16rpx;
  margin: 0;
  padding: 24rpx;
  min-height: 92rpx;
  font-weight: 600;
}
button::after { border: 0; }
button:active { opacity: .75; transform: scale(.98); }
button[disabled] { opacity: .45; }
.page { padding: 36rpx 32rpx 180rpx; max-width: 1100rpx; margin: auto; }
.orange { color: var(--accent); }
.muted { color: var(--muted); }
.small { font-size: 28rpx; line-height: 1.6; }
.bold { font-weight: 600; }
.row { display: flex; align-items: center; gap: 20rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.heading { font-size: 46rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.3; margin: 12rpx 0 28rpx; }
.section { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; font-size: 34rpx; font-weight: 600; margin: 40rpx 0 22rpx; }
.card { background: var(--surface); border-radius: 24rpx; padding: 28rpx; margin: 20rpx 0; }
.primary { background: var(--text); color: var(--surface); }
.secondary { background: #e9edef; color: var(--text); }
.danger { color: #ad3232; background: #f9eaea; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0; }
.fallback { background: #eceff1; color: #555e65; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 34rpx; }
.chip, .tag { background: #fceee5; color: var(--accent); border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 28rpx; }
.status { font-size: 26rpx; border-radius: 8rpx; padding: 6rpx 12rpx; white-space: nowrap; flex-shrink: 0; background: #eef0f2; color: #596168; }
.status-1 { background: #fceee5; color: #a54616; }
.status-2 { background: #e6f1eb; color: #34694c; }
.divider { height: 2rpx; background: var(--border); margin: 28rpx 0; }
.empty { padding: 48rpx 20rpx; text-align: center; color: var(--muted); font-size: 30rpx; }
.field-label { display: block; font-size: 28rpx; color: var(--text); margin: 28rpx 0 14rpx; }
input, textarea { background: var(--raised); border-radius: 16rpx; padding: 22rpx; width: 100%; font-size: 30rpx; }
input { height: 96rpx; }
textarea { height: 210rpx; }
.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; flex-wrap: wrap; }
.button-row button, .button-row picker { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice { padding: 24rpx; border-radius: 16rpx; background: #eceff1; color: var(--text); font-size: 30rpx; line-height: 1.6; }
.pill { padding: 22rpx 16rpx; border-radius: 16rpx; background: var(--raised); font-size: 28rpx; min-height: 88rpx; text-align: center; }
.media-grid { display: flex; gap: 16rpx; flex-wrap: wrap; }
.media-item { width: 46%; }
.media-item image { width: 100%; height: 200rpx; border-radius: 16rpx; }
.media-delete { font-size: 28rpx; color: var(--accent); text-align: center; padding: 20rpx 0; }
video { width: 100%; border-radius: 16rpx; margin-top: 20rpx; }
.back { font-size: 30rpx; color: var(--accent); margin-bottom: 24rpx; }
